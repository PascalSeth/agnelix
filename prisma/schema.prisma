generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── NextAuth required models ──────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ── Playbook Engine ───────────────────────────────────────────────────────────

model Playbook {
  id                String   @id @default(cuid())
  type              String   @unique
  name              String
  targetVerticals   Json
  discoveryMethod   String
  platformOptions   Json?
  sequenceTemplates Json
  proposalTemplates Json
  reportMetrics     Json
  reportTemplates   Json
  portalTemplates   Json
  portalSections    Json
  toneOptions       Json
  objectionHandlers Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("playbooks")
}

// ── Application models ───────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  companyName    String?
  companyDesc    String?
  title          String?
  tone           String?  @default("Professional")
  role           Role     @default(USER)
  agencyLogo     String?
  agencyName     String?
  fromEmail      String?
  smtpPass       String?
  smtpHost       String?
  smtpPort       Int?
  onboardingDone Boolean  @default(false)
  calendarLink   String?

  // NEW: Playbook & Identity
  playbookType      String?   @default("sales")
  brandColor        String?
  domain            String?
  timezone          String    @default("Europe/London")
  currency          String    @default("GBP")
  imapEnabled       Boolean   @default(false)
  gmailAppPassword  String?

  campaigns      Campaign[]
  leads          Lead[]
  sequences      Sequence[]
  autoSearches   AutoSearch[]
  pendingActions PendingAction[]
  agentGoal      AgentGoal?
  agentMemories  AgentMemory[]
  digestLogs     AgentDigestLog[]

  // NEW: Phase 1 & 2 relations
  proposals         Proposal[]
  caseStudies       CaseStudy[]
  clientPortals     ClientPortal[]
  clientReports     ClientReport[]

  @@map("users")
}

enum Role {
  USER
  ADMIN
}

model Lead {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  email         String
  firstName     String?
  lastName      String?
  title         String?
  company       String?
  companyDesc   String?
  industry      String?
  website       String?
  linkedinUrl   String?
  recentNews    String?
  painPoint     String?
  googlePlaceId String?
  notes         String? @db.Text

  status     LeadStatus @default(NEW)
  dealValue  Float?
  battleCard String?    @db.Text

  auditJson            String? @db.Text
  contactsJson         String? @db.Text
  linkedinProfilesJson String? @db.Text
  recommendedApproach  String?

  // NEW: Playbook Context
  platformFocus     String?
  sourceQuery       String?

  // NEW: AI Research
  icebreaker        String? @db.Text
  researchNotes     String? @db.Text
  painPoints        Json?
  competitorAnalysis String? @db.Text

  // NEW: Buying Signals (news, leadership changes, hiring, funding etc.)
  buyingSignalsJson String?   @db.Text
  signalsCheckedAt  DateTime?

  // NEW: Engagement Counters
  emailsSentCount    Int       @default(0)
  emailsOpenedCount  Int       @default(0)
  repliesReceivedCount Int     @default(0)
  meetingsBookedCount Int      @default(0)
  lastContactedAt    DateTime?
  dealCurrency       String    @default("GBP")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emails         Email[]
  campaignLeads  CampaignLead[]
  replies        Reply[]
  activities     Activity[]
  pendingActions PendingAction[]
  agentMemories  AgentMemory[]

  // NEW: Relations
  proposals      Proposal[]
  leadNotes      Note[]

  @@index([userId])
  @@index([status])
  @@map("leads")
}

enum LeadStatus {
  NEW
  CONTACTED
  REPLIED
  INTERESTED
  MEETING_BOOKED
  PROPOSAL_SENT
  WON
  LOST
  NOT_INTERESTED
  BOUNCED
}

model Campaign {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name       String
  status     CampaignStatus @default(DRAFT)
  sequenceId String
  sequence   Sequence       @relation(fields: [sequenceId], references: [id])

  totalLeads     Int       @default(0)
  emailsSent     Int       @default(0)
  emailsOpened   Int       @default(0)
  emailsClicked  Int       @default(0)
  replies        Int       @default(0)
  meetings       Int       @default(0)

  autonomous Boolean @default(false)

  // NEW: Playbook & Workflow
  playbookType   String?
  targetVertical String?
  platformFocus  String?
  workflowStage  WorkflowStage @default(ENRICH)
  revenueAttributed Float?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  launchedAt DateTime?

  emails        Email[]
  campaignLeads CampaignLead[]
  autoSearches  AutoSearch[]

  // NEW: Relations
  clientPortal  ClientPortal?
  clientReports ClientReport[]
  proposals     Proposal[]

  @@index([userId])
  @@index([status])
  @@map("campaigns")
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum WorkflowStage {
  ENRICH
  DRAFT
  REVIEW
  SEND
  LIVE
}

model CampaignLead {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())

  // NEW: Step Tracking
  currentStep       Int       @default(0)
  campaignStatus    CampaignLeadStatus @default(PENDING)
  generatedEmails   Json?

  @@unique([campaignId, leadId])
  @@map("campaign_leads")
}

enum CampaignLeadStatus {
  PENDING
  ENRICHING
  DRAFTING
  READY
  SENT
  REPLIED
  BOUNCED
  UNSUBSCRIBED
}

model Sequence {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  isDefault Boolean @default(false)

  // NEW: Template System
  isTemplate   Boolean  @default(false)
  playbookType String?
  description  String?  @db.Text

  steps        SequenceStep[]
  campaigns    Campaign[]
  autoSearches AutoSearch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sequences")
}

model SequenceStep {
  id         String   @id @default(cuid())
  sequenceId String
  sequence   Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  stepNumber      Int
  delayDays       Int
  subjectTemplate String?
  bodyTemplate    String?

  // NEW: Step Types
  stepType   StepType  @default(EMAIL)
  aiPrompt   String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sequenceId])
  @@map("sequence_steps")
}

enum StepType {
  EMAIL
  LINKEDIN_CONNECT
  LINKEDIN_MESSAGE
  WAIT
}

model Email {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  subject   String
  body      String  @db.Text
  aiPrompt  String? @db.Text

  status    EmailStatus @default(DRAFT)
  sentAt    DateTime?
  messageId String?
  scheduledAt DateTime?

  openedAt   DateTime?
  clickedAt  DateTime?
  openCount  Int       @default(0)
  clickCount Int       @default(0)

  repliedAt     DateTime?
  replySnippet  String?   @db.Text

  stepNumber Int
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id])

  // NEW: Rich Content & AI
  bodyHtml    String?   @db.Text
  aiDraft     String?   @db.Text
  aiDraftTone String?
  intent      EmailIntent?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trackingEvents TrackingEvent[]
  replies        Reply[]

  @@index([leadId])
  @@index([status])
  @@index([messageId])
  @@index([scheduledAt])
  @@map("emails")
}

enum EmailStatus {
  DRAFT
  QUEUED
  SENT
  DELIVERED
  OPENED
  CLICKED
  REPLIED
  BOUNCED
  FAILED
}

enum EmailIntent {
  INTERESTED
  MEETING_REQUEST
  OBJECTION
  REFERRAL
  UNSUBSCRIBE
  NOT_INTERESTED
  NURTURE
  NEEDS_INFO
}

model AutoSearch {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  query        String
  location     String
  sequenceId   String
  sequence     Sequence  @relation(fields: [sequenceId], references: [id])
  campaignName String
  campaignId   String?
  campaign     Campaign? @relation(fields: [campaignId], references: [id])

  enabled       Boolean   @default(true)
  frequency     String    @default("daily")
  lastRunAt     DateTime?
  totalImported Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("auto_searches")
}

model Reply {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  emailId    String?
  email      Email?   @relation(fields: [emailId], references: [id])
  fromEmail  String
  subject    String?
  body       String   @db.Text
  receivedAt DateTime @default(now())

  // NEW: AI Processing
  intent      EmailIntent?
  aiDraft     String?   @db.Text
  aiDraftTone String?
  status      ReplyStatus @default(RECEIVED)

  pendingActions PendingAction[]

  @@index([leadId])
  @@map("replies")
}

enum ReplyStatus {
  RECEIVED
  DRAFTED
  REVIEWING
  APPROVED
  SENT
  SCHEDULED
}

model Activity {
  id        String       @id @default(cuid())
  leadId    String
  lead      Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      ActivityType
  note      String?      @db.Text
  metadata  Json?
  createdAt DateTime     @default(now())

  @@index([leadId])
  @@map("activities")
}

enum ActivityType {
  EMAIL_SENT
  EMAIL_OPENED
  EMAIL_CLICKED
  REPLY_RECEIVED
  STAGE_CHANGED
  NOTE_ADDED
  MEETING_BOOKED
  DEAL_WON
  DEAL_LOST
  BATTLE_CARD_GENERATED
  PROPOSAL_GENERATED
  PROPOSAL_SENT
  PROPOSAL_VIEWED
  PROPOSAL_SIGNED
  CASE_STUDY_ATTACHED
  COMPETITOR_ANALYSIS_GENERATED
  PORTAL_ACTIVATED
  PORTAL_VIEWED
  REPORT_SENT
  REPORT_VIEWED
  ONBOARDING_COMPLETED
  ONBOARDING_STEP_COMPLETED
  LINKEDIN_TASK_GENERATED
}

model Note {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  content   String   @db.Text
  createdBy String

  createdAt DateTime @default(now())

  @@index([leadId])
  @@map("notes")
}

model TrackingEvent {
  id        String  @id @default(cuid())
  eventType String
  emailId   String
  email     Email   @relation(fields: [emailId], references: [id], onDelete: Cascade)
  leadEmail String
  ipAddress String?
  userAgent String?
  timestamp DateTime @default(now())

  @@index([emailId])
  @@index([leadEmail])
  @@map("tracking_events")
}

model PendingAction {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId  String
  lead    Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  replyId String?
  reply   Reply?  @relation(fields: [replyId], references: [id])

  type         PendingActionType
  intent       String
  draftSubject String?
  draftBody    String              @db.Text
  metadata     Json?
  riskLevel    PendingRiskLevel    @default(HIGH)
  confidence   PendingConfidence   @default(LOW)

  expiresAt  DateTime?
  status     PendingActionStatus @default(PENDING)
  executedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@map("pending_actions")
}

enum PendingActionType {
  SEND_REPLY
  ENROLL_NURTURE
  UPDATE_STAGE
  BOOK_MEETING
  SEND_PROPOSAL
  GENERATE_CASE_STUDY
}

enum PendingActionStatus {
  PENDING
  APPROVED
  REJECTED
  AUTO_EXECUTED
}

enum PendingRiskLevel {
  LOW
  HIGH
}

enum PendingConfidence {
  LOW
  MEDIUM
  HIGH
}

model AgentGoal {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  meetingsPerMonth Int @default(5)
  replyRateTarget Float @default(8)
  dailyLeadCap Int @default(40)
  autoSendEnabled Boolean @default(true)
  autoProspectingEnabled Boolean @default(false)
  reviewWindowMins Int @default(5)
  maxAutoSendsPerDay Int @default(12)
  minConfidence PendingConfidence @default(MEDIUM)
  personaConfig Json?
  lowPriorityDelayMins   Int @default(2)
  highPriorityDelayMins  Int @default(15)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("agent_goals")
}

model AgentMemory {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId String?
  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  intent String
  responseStyle String?
  ctaType String?
  outcome String
  won Boolean @default(false)
  bookedMeeting Boolean @default(false)
  responseLatencyMins Int?
  score Float @default(0)
  notes String? @db.Text
  metadata Json?

  createdAt DateTime @default(now())

  @@index([userId, intent])
  @@index([createdAt])
  @@map("agent_memories")
}

model AgentDigestLog {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  day DateTime
  sentCount Int @default(0)
  approvedCount Int @default(0)
  meetingsBookedCount Int @default(0)
  proposalsSentCount Int @default(0)
  rejectedCount Int @default(0)
  flaggedCount Int @default(0)
  anomalies Json?
  summary String? @db.Text

  createdAt DateTime @default(now())

  @@unique([userId, day])
  @@index([day])
  @@map("agent_digest_logs")
}

model DomainContactCache {
  id           String   @id @default(cuid())
  domain       String   @unique
  contactsJson String?  @db.Text
  profilesJson String?  @db.Text
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@index([domain])
  @@map("domain_contact_caches")
}

// ── Phase 1: Conversion Layer ─────────────────────────────────────────────────

model Proposal {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id])

  title       String
  contentJson Json
  executiveSummary String? @db.Text

  pricingPackages Json
  totalValue    Float?
  currency      String @default("GBP")

  status      ProposalStatus @default(DRAFT)
  sentAt      DateTime?
  viewedAt    DateTime?
  signedAt    DateTime?
  expiredAt   DateTime?
  signatureData Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([leadId])
  @@index([status])
  @@map("proposals")
}

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  SIGNED
  EXPIRED
  DECLINED
}

model CaseStudy {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  clientName  String
  industry    String
  nicheTags   Json
  challenge   String   @db.Text
  solution    String   @db.Text
  results     String   @db.Text
  testimonialQuote String? @db.Text
  metrics     Json?
  imageUrls   Json?
  usageCount  Int      @default(0)
  aiSummary   String?  @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([industry])
  @@map("case_studies")
}

// ── Phase 2: Client Layer ───────────────────────────────────────────────────

model ClientPortal {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId  String   @unique
  campaign    Campaign @relation(fields: [campaignId], references: [id])

  portalTemplate String?
  enabledSections Json
  customSections  Json?

  logoUrl     String?
  brandColor  String?
  customDomain String?
  accessUrl   String     @unique
  accessToken String
  isActive    Boolean    @default(true)

  lastViewedAt DateTime?
  viewCount    Int       @default(0)

  reports     ClientReport[]
  documents   PortalDocument[]
  messages    PortalMessage[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@map("client_portals")
}

model ClientReport {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id])
  portalId    String?
  portal      ClientPortal? @relation(fields: [portalId], references: [id])

  reportTemplate String?
  periodStart    DateTime
  periodEnd      DateTime
  metricsJson    Json
  aiNarrative    String?   @db.Text

  pdfUrl      String?
  status      ReportStatus @default(DRAFT)
  sentAt      DateTime?
  scheduledSendAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([campaignId])
  @@map("client_reports")
}

enum ReportStatus {
  DRAFT
  SCHEDULED
  SENT
  VIEWED
}

model PortalDocument {
  id          String   @id @default(cuid())
  portalId    String
  portal      ClientPortal @relation(fields: [portalId], references: [id], onDelete: Cascade)

  name        String
  fileUrl     String
  fileType    String
  category    String
  uploadedBy  String

  createdAt   DateTime @default(now())

  @@index([portalId])
  @@map("portal_documents")
}

model PortalMessage {
  id          String   @id @default(cuid())
  portalId    String
  portal      ClientPortal @relation(fields: [portalId], references: [id], onDelete: Cascade)

  direction   String
  content     String   @db.Text

  createdAt   DateTime @default(now())

  @@index([portalId])
  @@map("portal_messages")
}
