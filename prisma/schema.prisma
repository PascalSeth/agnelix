generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── NextAuth required models ──────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ── Playbook Engine ───────────────────────────────────────────────────────────

model Playbook {
  id                String @id @default(cuid())
  type              String @unique
  name              String
  targetVerticals   Json
  discoveryMethod   String
  platformOptions   Json?
  sequenceTemplates Json
  proposalTemplates Json
  reportMetrics     Json
  reportTemplates   Json
  portalTemplates   Json
  portalSections    Json
  toneOptions       Json
  objectionHandlers Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("playbooks")
}

// ── Application models ───────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  companyName    String?
  companyDesc    String?
  title          String?
  tone           String? @default("Professional")
  role           Role    @default(USER)
  agencyLogo     String?
  agencyName     String?
  fromEmail      String?
  smtpPass       String?
  smtpHost       String?
  smtpPort       Int?
  onboardingDone Boolean @default(false)
  calendarLink   String?
  lastTrialAt    DateTime?
  trialCount     Int       @default(0)

  // NEW: Flagship offer (SMM playbook step 2) — { name, transformation, deliverable }
  // Injected into step-1 outreach emails and proposal generation.
  flagshipOffer Json?

  // NEW: Playbook & Identity
  playbookType     String? @default("sales")
  brandColor       String?
  domain           String?
  timezone         String   @default("Europe/London")
  currency         Currency @default(USD)
  imapEnabled      Boolean  @default(false)
  gmailAppPassword String?
  lastActiveAt     DateTime? @default(now())

  // IMAP delta-sync state — tracks the highest UID seen so we only fetch new messages each run
  imapLastUid    Int?      // highest IMAP UID successfully processed; NULL = full scan on next run
  imapLastSyncAt DateTime? // timestamp of last successful IMAP sync completion

  teamOwnerId String?
  teamOwner   User?        @relation("TeamMembers", fields: [teamOwnerId], references: [id])
  teamMembers User[]       @relation("TeamMembers")
  sentInvites TeamInvite[]

  campaigns      Campaign[]
  leads          Lead[]
  sequences      Sequence[]
  autoSearches   AutoSearch[]
  pendingActions PendingAction[]
  agentGoal      AgentGoal?
  agentMemories  AgentMemory[]
  digestLogs     AgentDigestLog[]

  // NEW: Phase 1 & 2 relations
  proposals     Proposal[]
  caseStudies   CaseStudy[]
  clientPortals ClientPortal[]
  clientReports ClientReport[]

  // NEW: Phase D relations
  contentItems     ContentCalendar[]
  clientFinancials ClientFinancials[]
  agentInsights    AgentInsight[]

  // Agency-owned AI training rules (taught from the AI Settings page)
  aiTrainingRules AiTrainingRule[]

  @@map("users")
}

enum Currency {
  USD
  EUR
  GBP
  CAD
  GHS
  NGN
}

enum Role {
  USER
  MANAGER
  ADMIN
  SUPERADMIN
}

model TeamInvite {
  id        String           @id @default(cuid())
  ownerId   String
  owner     User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  email     String
  token     String           @unique @default(cuid())
  status    TeamInviteStatus @default(PENDING)
  createdAt DateTime         @default(now())
  expiresAt DateTime

  @@index([ownerId])
  @@map("team_invites")
}

enum TeamInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

model Lead {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  email         String
  firstName     String?
  lastName      String?
  title         String?
  company       String?
  companyDesc   String?
  industry      String?
  website       String?
  linkedinUrl   String?
  recentNews    String?
  painPoint     String?
  googlePlaceId String?
  notes         String? @db.Text

  status     LeadStatus @default(NEW)
  dealValue  Float?
  battleCard String?    @db.Text

  auditJson            String? @db.Text
  contactsJson         String? @db.Text
  linkedinProfilesJson String? @db.Text
  recommendedApproach  String?

  // NEW: Playbook Context
  platformFocus String?
  sourceQuery   String?

  // NEW: AI Research
  icebreaker         String? @db.Text
  researchNotes      String? @db.Text
  painPoints         Json?
  competitorAnalysis String? @db.Text

  // NEW: Buying Signals (news, leadership changes, hiring, funding etc.)
  buyingSignalsJson String?   @db.Text
  signalsCheckedAt  DateTime?

  // NEW: Social content audit (profiles found, missing platforms, mentions)
  socialAuditJson String? @db.Text

  // NEW: Engagement Counters
  emailsSentCount      Int       @default(0)
  emailsOpenedCount    Int       @default(0)
  repliesReceivedCount Int       @default(0)
  meetingsBookedCount  Int       @default(0)
  lastContactedAt      DateTime?
  dealCurrency         Currency  @default(USD)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emails         Email[]
  campaignLeads  CampaignLead[]
  replies        Reply[]
  activities     Activity[]
  pendingActions PendingAction[]
  agentMemories  AgentMemory[]

  // NEW: Relations
  proposals Proposal[]
  leadNotes Note[]

  // NEW: Phase D relations
  clientPortals    ClientPortal[]
  clientFinancials ClientFinancials[]
  agentInsights    AgentInsight[]

  @@index([userId])
  @@index([status])
  @@map("leads")
}

enum LeadStatus {
  NEW
  CONTACTED
  REPLIED
  INTERESTED
  MEETING_BOOKED
  PROPOSAL_SENT
  WON
  LOST
  NOT_INTERESTED
  BOUNCED
}

model Campaign {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name       String
  status     CampaignStatus @default(DRAFT)
  sequenceId String
  sequence   Sequence       @relation(fields: [sequenceId], references: [id])

  totalLeads    Int @default(0)
  emailsSent    Int @default(0)
  emailsOpened  Int @default(0)
  emailsClicked Int @default(0)
  replies       Int @default(0)
  meetings      Int @default(0)

  autonomous Boolean @default(false)

  // NEW: Playbook & Workflow
  playbookType      String?
  targetVertical    String?
  platformFocus     String?
  workflowStage     WorkflowStage @default(ENRICH)
  revenueAttributed Float?

  // NEW: what the client wants to achieve (grow_audience, go_viral, drive_sales,
  // build_community, generate_leads, brand_awareness) — flows into AI prompts & reports
  clientGoal String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  launchedAt DateTime?

  emails        Email[]
  campaignLeads CampaignLead[]
  autoSearches  AutoSearch[]

  // NEW: Relations
  clientPortal  ClientPortal?
  clientReports ClientReport[]
  proposals     Proposal[]

  // NEW: multi-campaign portal membership
  portalCampaigns PortalCampaign[]

  @@index([userId])
  @@index([status])
  @@map("campaigns")
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum WorkflowStage {
  ENRICH
  DRAFT
  REVIEW
  SEND
  LIVE
}

model CampaignLead {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())

  // NEW: Step Tracking
  currentStep     Int                @default(0)
  campaignStatus  CampaignLeadStatus @default(PENDING)
  generatedEmails Json?

  @@unique([campaignId, leadId])
  @@map("campaign_leads")
}

enum CampaignLeadStatus {
  PENDING
  ENRICHING
  DRAFTING
  READY
  SENT
  REPLIED
  BOUNCED
  UNSUBSCRIBED
}

model Sequence {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  isDefault Boolean @default(false)

  // NEW: Template System
  isTemplate   Boolean @default(false)
  playbookType String?
  description  String? @db.Text

  steps        SequenceStep[]
  campaigns    Campaign[]
  autoSearches AutoSearch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sequences")
}

model SequenceStep {
  id         String   @id @default(cuid())
  sequenceId String
  sequence   Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  stepNumber      Int
  delayDays       Int
  subjectTemplate String?
  bodyTemplate    String?

  // NEW: Step Types
  stepType StepType @default(EMAIL)
  aiPrompt String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sequenceId])
  @@map("sequence_steps")
}

enum StepType {
  EMAIL
  LINKEDIN_CONNECT
  LINKEDIN_MESSAGE
  WAIT
}

model Email {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  subject  String
  body     String  @db.Text
  aiPrompt String? @db.Text

  status      EmailStatus @default(DRAFT)
  sentAt      DateTime?
  messageId   String?
  scheduledAt DateTime?

  openedAt   DateTime?
  clickedAt  DateTime?
  openCount  Int       @default(0)
  clickCount Int       @default(0)

  repliedAt    DateTime?
  replySnippet String?   @db.Text

  stepNumber Int
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id])

  // NEW: Rich Content & AI
  bodyHtml    String?      @db.Text
  aiDraft     String?      @db.Text
  aiDraftTone String?
  intent      EmailIntent?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trackingEvents TrackingEvent[]
  replies        Reply[]

  @@index([leadId])
  @@index([status])
  @@index([messageId])
  @@index([scheduledAt])
  @@map("emails")
}

enum EmailStatus {
  DRAFT
  QUEUED
  SENT
  DELIVERED
  OPENED
  CLICKED
  REPLIED
  BOUNCED
  FAILED
}

enum EmailIntent {
  INTERESTED
  MEETING_REQUEST
  OBJECTION
  REFERRAL
  UNSUBSCRIBE
  NOT_INTERESTED
  NURTURE
  NEEDS_INFO
}

model AutoSearch {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  query        String
  location     String
  sequenceId   String
  sequence     Sequence  @relation(fields: [sequenceId], references: [id])
  campaignName String
  campaignId   String?
  campaign     Campaign? @relation(fields: [campaignId], references: [id])

  enabled       Boolean   @default(true)
  frequency     String    @default("daily")
  lastRunAt     DateTime?
  totalImported Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("auto_searches")
}

model Reply {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  emailId    String?
  email      Email?   @relation(fields: [emailId], references: [id])
  fromEmail  String
  subject    String?
  body       String   @db.Text
  receivedAt DateTime @default(now())

  // NEW: AI Processing
  intent      EmailIntent?
  aiDraft     String?      @db.Text
  aiDraftTone String?
  status      ReplyStatus  @default(RECEIVED)

  pendingActions PendingAction[]

  @@index([leadId])
  @@map("replies")
}

enum ReplyStatus {
  RECEIVED
  DRAFTED
  REVIEWING
  APPROVED
  SENT
  SCHEDULED
}

model Activity {
  id        String       @id @default(cuid())
  leadId    String
  lead      Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      ActivityType
  note      String?      @db.Text
  metadata  Json?
  createdAt DateTime     @default(now())

  @@index([leadId])
  @@map("activities")
}

enum ActivityType {
  EMAIL_SENT
  EMAIL_OPENED
  EMAIL_CLICKED
  REPLY_RECEIVED
  STAGE_CHANGED
  NOTE_ADDED
  MEETING_BOOKED
  DEAL_WON
  DEAL_LOST
  BATTLE_CARD_GENERATED
  PROPOSAL_GENERATED
  PROPOSAL_SENT
  PROPOSAL_VIEWED
  PROPOSAL_SIGNED
  CASE_STUDY_ATTACHED
  COMPETITOR_ANALYSIS_GENERATED
  PORTAL_ACTIVATED
  PORTAL_VIEWED
  REPORT_SENT
  REPORT_VIEWED
  ONBOARDING_COMPLETED
  ONBOARDING_STEP_COMPLETED
  LINKEDIN_TASK_GENERATED
}

model Note {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  content   String @db.Text
  createdBy String

  createdAt DateTime @default(now())

  @@index([leadId])
  @@map("notes")
}

model TrackingEvent {
  id        String   @id @default(cuid())
  eventType String
  emailId   String
  email     Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)
  leadEmail String
  ipAddress String?
  userAgent String?
  timestamp DateTime @default(now())

  @@index([emailId])
  @@index([leadEmail])
  @@map("tracking_events")
}

model PendingAction {
  id      String  @id @default(cuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId  String
  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  replyId String?
  reply   Reply?  @relation(fields: [replyId], references: [id])

  type         PendingActionType
  intent       String
  draftSubject String?
  draftBody    String            @db.Text
  metadata     Json?
  riskLevel    PendingRiskLevel  @default(HIGH)
  confidence   PendingConfidence @default(LOW)

  expiresAt  DateTime?
  status     PendingActionStatus @default(PENDING)
  executedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@map("pending_actions")
}

enum PendingActionType {
  SEND_REPLY
  ENROLL_NURTURE
  UPDATE_STAGE
  BOOK_MEETING
  SEND_PROPOSAL
  GENERATE_CASE_STUDY
  LINKEDIN_TASK
}

enum PendingActionStatus {
  PENDING
  APPROVED
  REJECTED
  AUTO_EXECUTED
}

enum PendingRiskLevel {
  LOW
  HIGH
}

enum PendingConfidence {
  LOW
  MEDIUM
  HIGH
}

model AgentGoal {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  meetingsPerMonth       Int               @default(5)
  replyRateTarget        Float             @default(8)
  dailyLeadCap           Int               @default(40)
  autoSendEnabled        Boolean           @default(true)
  autoProspectingEnabled Boolean           @default(false)
  reviewWindowMins       Int               @default(5)
  maxAutoSendsPerDay     Int               @default(12)
  minConfidence          PendingConfidence @default(MEDIUM)
  personaConfig          Json?
  lowPriorityDelayMins   Int               @default(2)
  highPriorityDelayMins  Int               @default(15)

  // Criticality-based response delay matrix & offline auto-pilot
  autoSendOnlyWhenOffline Boolean           @default(false)
  criticalDelayMins       Int               @default(1)
  questionDelayMins       Int               @default(5)
  objectionDelayMins      Int               @default(15)
  offlineDelayMins        Int               @default(2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("agent_goals")
}

model AgentMemory {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  intent              String
  responseStyle       String?
  ctaType             String?
  outcome             String
  won                 Boolean @default(false)
  bookedMeeting       Boolean @default(false)
  responseLatencyMins Int?
  score               Float   @default(0)
  notes               String? @db.Text
  metadata            Json?

  createdAt DateTime @default(now())

  @@index([userId, intent])
  @@index([createdAt])
  @@map("agent_memories")
}

model AgentDigestLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  day                 DateTime
  sentCount           Int      @default(0)
  approvedCount       Int      @default(0)
  meetingsBookedCount Int      @default(0)
  proposalsSentCount  Int      @default(0)
  rejectedCount       Int      @default(0)
  flaggedCount        Int      @default(0)
  anomalies           Json?
  summary             String?  @db.Text

  createdAt DateTime @default(now())

  @@unique([userId, day])
  @@index([day])
  @@map("agent_digest_logs")
}

model DomainContactCache {
  id           String   @id @default(cuid())
  domain       String   @unique
  contactsJson String?  @db.Text
  profilesJson String?  @db.Text
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@index([domain])
  @@map("domain_contact_caches")
}

// ── Phase 1: Conversion Layer ─────────────────────────────────────────────────

model Proposal {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId     String
  lead       Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id])

  title            String
  contentJson      Json
  executiveSummary String? @db.Text

  pricingPackages Json
  totalValue      Float?
  currency        Currency @default(USD)

  status        ProposalStatus @default(DRAFT)
  sentAt        DateTime?
  viewedAt      DateTime?
  signedAt      DateTime?
  expiredAt     DateTime?
  signatureData Json?

  // NEW: feedback loop — why the client declined; fed back into future generations
  declineReason String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([leadId])
  @@index([status])
  @@map("proposals")
}

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  SIGNED
  EXPIRED
  DECLINED
}

model CaseStudy {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  clientName       String
  industry         String
  nicheTags        Json
  challenge        String  @db.Text
  solution         String  @db.Text
  results          String  @db.Text
  testimonialQuote String? @db.Text
  metrics          Json?
  imageUrls        Json?
  usageCount       Int     @default(0)
  aiSummary        String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([industry])
  @@map("case_studies")
}

// ── Phase 2: Client Layer ───────────────────────────────────────────────────

model ClientPortal {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId String   @unique
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  // NEW: portal belongs to a won client (lead) and can span multiple campaigns.
  // campaignId above remains the primary campaign for backward compatibility.
  leadId          String?
  lead            Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  portalCampaigns PortalCampaign[]

  portalTemplate  String?
  enabledSections Json
  customSections  Json?

  logoUrl      String?
  brandColor   String?
  customDomain String?
  accessUrl    String  @unique
  accessToken  String
  isActive     Boolean @default(true)

  lastViewedAt DateTime?
  viewCount    Int       @default(0)

  reports   ClientReport[]
  documents PortalDocument[]
  messages  PortalMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("client_portals")
}

model ClientReport {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId String
  campaign   Campaign      @relation(fields: [campaignId], references: [id])
  portalId   String?
  portal     ClientPortal? @relation(fields: [portalId], references: [id])

  reportTemplate String?
  periodStart    DateTime
  periodEnd      DateTime
  metricsJson    Json
  aiNarrative    String?  @db.Text

  pdfUrl          String?
  status          ReportStatus @default(DRAFT)
  sentAt          DateTime?
  scheduledSendAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([campaignId])
  @@map("client_reports")
}

enum ReportStatus {
  DRAFT
  SCHEDULED
  SENT
  VIEWED
}

model PortalDocument {
  id       String       @id @default(cuid())
  portalId String
  portal   ClientPortal @relation(fields: [portalId], references: [id], onDelete: Cascade)

  name       String
  fileUrl    String
  fileType   String
  category   String
  uploadedBy String

  createdAt DateTime @default(now())

  @@index([portalId])
  @@map("portal_documents")
}

model PortalMessage {
  id       String       @id @default(cuid())
  portalId String
  portal   ClientPortal @relation(fields: [portalId], references: [id], onDelete: Cascade)

  direction String
  content   String @db.Text

  createdAt DateTime @default(now())

  @@index([portalId])
  @@map("portal_messages")
}

// Junction: lets one client portal aggregate multiple campaigns (e.g. SEO + PPC for the same won client)
model PortalCampaign {
  portalId   String
  portal     ClientPortal @relation(fields: [portalId], references: [id], onDelete: Cascade)
  campaignId String
  campaign   Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())

  @@unique([portalId, campaignId])
  @@map("portal_campaigns")
}

// ── Phase D: Feature Modules ─────────────────────────────────────────────────

model ContentCalendar {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId   String?
  platform     String // instagram, tiktok, linkedin, x, facebook, pinterest
  scheduledFor DateTime
  contentType  String // post, story, reel, carousel, short
  caption      String        @db.Text
  mediaUrls    Json?
  hashtags     Json?
  status       ContentStatus @default(DRAFT)
  approvedAt   DateTime?
  postedAt     DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId])
  @@index([scheduledFor])
  @@map("content_calendar")
}

enum ContentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  POSTED
  FAILED
}

model ClientFinancials {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId      String // the won client
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  period      DateTime // month/year of period
  revenue     Float
  costs       Float
  grossMargin Float
  burnRate    Float?
  runway      Int? // months of runway
  currency    Currency @default(USD)
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([leadId, period])
  @@index([userId])
  @@index([leadId])
  @@map("client_financials")
}

model AgentInsight {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId    String?
  lead      Lead?       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      InsightType
  title     String
  body      String      @db.Text
  cta       String? // action URL or label
  metadata  Json?
  dismissed Boolean     @default(false)
  createdAt DateTime    @default(now())

  @@index([userId])
  @@index([userId, dismissed])
  @@map("agent_insights")
}

enum InsightType {
  CROSS_SELL_OPPORTUNITY
  RISK_ALERT
  PERFORMANCE_ANOMALY
  MILESTONE_REACHED
}

// ── AI Training ───────────────────────────────────────────────────────────────
// Live instruction layer injected into AI generations. Scoped globally or to a
// workspace/playbook type, and to a generation surface. Platform-wide rules
// (userId null) are managed at /admin by superadmins; agency-owned rules
// (userId set) are taught by a company itself from its AI Settings page and
// only ever apply to that company's own generations.

model AiTrainingRule {
  id          String    @id @default(cuid())
  scope       String    @default("global") // "global" or a playbook type (sales, seo, …)
  surface     AiSurface @default(ALL)
  title       String
  instruction String    @db.Text
  goodExample String?   @db.Text
  badExample  String?   @db.Text
  enabled     Boolean   @default(true)
  priority    Int       @default(0) // higher runs first
  source      String    @default("manual") // manual | session (taught via correction) | document (distilled from upload)
  sourceRef   String? // document title or training example id
  createdBy   String?
  userId      String? // set = agency-owned lesson (this company only); null = platform-wide rule set by a superadmin
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([scope, enabled])
  @@index([userId, enabled])
  @@map("ai_training_rules")
}

enum AiSurface {
  ALL
  EMAIL
  REPLY
  PROPOSAL
  ADVISOR
}

// A teaching exchange: scenario → AI response → admin correction → distilled lesson
model TrainingExample {
  id         String   @id @default(cuid())
  surface    String
  scope      String   @default("global")
  scenario   String   @db.Text
  aiResponse String   @db.Text
  correction String?  @db.Text
  feedback   String?  @db.Text
  ruleId     String? // the AiTrainingRule distilled from this correction
  createdAt  DateTime @default(now())

  @@map("training_examples")
}

// An uploaded document (PDF/textbook/notes) the AI has distilled lessons from
model TrainingDocument {
  id           String   @id @default(cuid())
  title        String
  content      String   @db.Text
  scope        String   @default("global")
  surface      String   @default("ALL")
  lessonsCount Int      @default(0)
  createdBy    String?
  createdAt    DateTime @default(now())

  @@map("training_documents")
}
